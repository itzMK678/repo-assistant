NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ai_software_engineer
FRONTEND_URL=http://localhost:3000

GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
GITHUB_CALLBACK_URL=http://localhost:5000/api/github/callback

SESSION_SECRET=YOUR_64_CHAR_HEX_SESSION_SECRET
ENCRYPTION_KEY=YOUR_64_CHAR_HEX_ENCRYPTION_KEY

DOCKER_SANDBOX_IMAGE=repoassistant-sandbox-node
SANDBOX_TIMEOUT_MS=60000
SANDBOX_MEMORY_MB=512
SANDBOX_CPU_COUNT=1
SANDBOX_PIDS_LIMIT=128

# =========================
# AI MODEL
# =========================

AI_PROVIDER=nebius

NEBIUS_BASE_URL=YOUR_NEBIUS_OPENAI_COMPATIBLE_BASE_URL
NEBIUS_API_KEY=YOUR_NEBIUS_API_KEY

NEBIUS_MODEL=YOUR_NEMOTRON_MODEL

# =========================
# AGENT
# =========================

MAX_AGENT_ITERATIONS=12
MAX_AGENT_TOOL_CALLS=30
MAX_AGENT_COMMANDS=15
MAX_AGENT_EXECUTION_TIME_MS=300000
MAX_AGENT_OUTPUT_SIZE=20000
MAX_AGENT_CHANGED_FILES=30
MAX_AGENT_FILE_SIZE=1000000